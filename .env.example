# Application
APP_NAME=notification-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/notif_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate limiting
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_CRITICAL_BURST_FACTOR=1.25

# Retry
MAX_RETRIES=3
RETRY_BASE_MINUTES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Mock provider failure rate (0.0 - 1.0)
MOCK_PROVIDER_FAILURE_RATE=0.05

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Preferences cache
PREFERENCE_CACHE_TTL_SECONDS=3600
TEMPLATE_CACHE_TTL_SECONDS=86400
